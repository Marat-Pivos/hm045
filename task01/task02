#include <iostream>
using namespace std;
#define NUMBER 3

int main() {
	srand(time(0));
	int vector[NUMBER];

	bool plus_numbers = true;

	for (int i = 0;i < NUMBER;i++) {
		vector[i] = rand() % 100 + 1;
		cout << vector[i] << " ";
	}

	for (int i = 0;i < NUMBER;i++) {
		for (int a = i + 1;a < NUMBER;a++) {
			if (vector[i] > vector[a]) {
				plus_numbers = false;break;
			}
		}
	}

	cout << (plus_numbers ? "All numbers are in ascending order" : "Not all numbers are in ascending order") << endl;

}
